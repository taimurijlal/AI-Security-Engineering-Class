# LLM provider: "ollama" (default, free, local) or "openai"
LLM_PROVIDER=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# OpenAI-compatible settings (only used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave blank for the real OpenAI API; set only for another OpenAI-compatible provider.
OPENAI_BASE_URL=
